# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# ── Environment & Secrets ────────────────────────────────────────────────
# NEVER commit real env files — use .env.example as template
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary & Cache files
.cache/
.vite/
.eslintcache
.nyc_output/
*.tmp
*.temp

# ── Test Outputs (Jenkins CI generates these — never commit) ─────────────
# JUnit XML reports
junit.xml
junit-frontend.xml
**/junit.xml
**/junit-frontend.xml

# Coverage reports (HTML, LCOV, JSON)
coverage/
**/coverage/
lcov.info
*.lcov

# Vitest / Jest snapshots that aren't source-controlled
**/__snapshots__/

# ── Security & Audit Reports (generated by pipeline) ────────────────────
# npm audit output
npm-audit-backend.json
npm-audit-frontend.json
**/npm-audit*.json

# ESLint reports
eslint-backend-report.txt
eslint-frontend-report.txt
**/eslint-*-report.txt

# Trivy image scan report
trivy-report.txt
trivy-*.json
trivy-*.txt

# ── Docker ───────────────────────────────────────────────────────────────
# Docker credential helpers (never commit)
.docker/
docker-credential-*

# ── Backend — Runtime Generated Files ────────────────────────────────────
# Uploaded resume files (created at runtime by multer)
backend/uploads/
uploads/
*.pdf
*.docx

# ── Jenkins ──────────────────────────────────────────────────────────────
# Jenkins workspace files (if running locally)
.jenkins/
jenkins_home/

# ── Package Manager Locks (keep package-lock.json, ignore others) ────────
yarn.lock
pnpm-lock.yaml
# Note: package-lock.json IS committed — ensures reproducible builds

# ── Miscellaneous ────────────────────────────────────────────────────────
# Compiled Python (if any tools installed)
__pycache__/
*.pyc
*.pyo

# Mac extended attributes
._*
.AppleDouble
.LSOverride

# Patch files
*.patch
*.diff