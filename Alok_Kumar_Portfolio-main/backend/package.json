{
  "name": "alok-portfolio-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "test:integration": "jest --config jest.config.js --testPathPattern=tests/ --forceExit",
    "test:unit": "jest --config jest.config.js --testPathPattern=tests/api --forceExit",
    "test:ci": "jest --config jest.config.js --coverage --forceExit --ci",
    "lint": "eslint . --ext .js --max-warnings=20",
    "lint:fix": "eslint . --ext .js --fix",
    "audit:check": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fs": "^0.0.1-security",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "openai": "^6.8.1",
    "pdf-parse": "^1.1.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^7.0.0"
  }
}
