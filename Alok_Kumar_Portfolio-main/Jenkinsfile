pipeline {
    agent any

    environment {
        APP_NAME = 'Alok_Kumar_Portfolio-main'

        // Docker image name must be lowercase
        IMAGE_NAME = 'officemealok/alok-kumar-portfolio'
        IMAGE_TAG = "${BUILD_NUMBER}"

        PROJECT_DIR = 'Alok_Kumar_Portfolio-main'
        BACKEND_DIR = 'Alok_Kumar_Portfolio-main/backend'
        FRONTEND_DIR = 'Alok_Kumar_Portfolio-main/frontend'

        CONTAINER_TEST_PORT = '3001'
        PRODUCTION_PORT = '80'
    }

    stages {

        stage('Install Backend Dependencies') {
            steps {
                echo 'Installing Backend dependencies...'

                dir("${BACKEND_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Install Frontend Dependencies') {
            steps {
                echo 'Installing Frontend dependencies...'

                dir("${FRONTEND_DIR}") {
                    sh 'npm install'
                }
            }
        }

        stage('Backend Unit Tests') {
            steps {
                echo 'Running Backend tests...'

                dir("${BACKEND_DIR}") {
                    sh 'npm run test --if-present'
                }
            }
        }

        stage('Frontend Unit Tests') {
            steps {
                echo 'Running Frontend tests...'

                dir("${FRONTEND_DIR}") {
                    sh 'npm run test --if-present'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                echo 'Building Frontend application...'

                dir("${FRONTEND_DIR}") {
                    sh 'npm run build'
                }
            }
        }

        stage('Verify Docker Files') {
    steps {
        dir("${PROJECT_DIR}") {
            sh '''
                echo "======================================"
                echo "Current Directory"
                echo "======================================"
                pwd

                echo ""
                echo "======================================"
                echo "Project Structure"
                echo "======================================"
                ls -la

                echo ""
                echo "======================================"
                echo "Backend Structure"
                echo "======================================"
                find backend -maxdepth 3 -type f -print

                echo ""
                echo "======================================"
                echo "Frontend Structure"
                echo "======================================"
                find frontend -maxdepth 2 -type f -print

                echo ""
                echo "======================================"
                echo "Dockerfile"
                echo "======================================"
                test -f Dockerfile

                echo ""
                echo "======================================"
                echo "Backend package.json"
                echo "======================================"
                test -f backend/package.json

                echo ""
                echo "Dockerfile and backend package.json found."
            '''
        }
    }
}

        stage('Build Docker Image') {
            steps {
                echo "Building Docker image: ${IMAGE_NAME}:${IMAGE_TAG}..."

                dir("${PROJECT_DIR}") {
                    sh """
                        docker build \
                            -t ${IMAGE_NAME}:${IMAGE_TAG} \
                            -t ${IMAGE_NAME}:latest \
                            .
                    """
                }
            }
        }

        stage('Test Container Runtime') {
    steps {
        echo 'Testing Docker container...'

        sh """
            set -e

            docker stop ${APP_NAME}-test || true
            docker rm ${APP_NAME}-test || true

            docker run -d \\
                --name ${APP_NAME}-test \\
                -p ${CONTAINER_TEST_PORT}:3000 \\
                ${IMAGE_NAME}:${IMAGE_TAG}

            echo "Waiting for container startup..."
            sleep 10

            echo "======================================"
            echo "Container Status"
            echo "======================================"

            docker ps -a --filter "name=${APP_NAME}-test"

            echo "======================================"
            echo "Container Logs"
            echo "======================================"

            docker logs ${APP_NAME}-test

            echo "======================================"
            echo "Checking Container Running Status"
            echo "======================================"

            if [ "\$(docker inspect -f '{{.State.Running}}' ${APP_NAME}-test)" != "true" ]; then
                echo "ERROR: Container has stopped."
                exit 1
            fi

            echo "Container is running."

            echo "======================================"
            echo "Testing Health Endpoint"
            echo "======================================"

            curl --fail --retry 5 --retry-delay 2 \\
                http://localhost:${CONTAINER_TEST_PORT}/api/health

            echo ""
            echo "Container health check successful."

            docker stop ${APP_NAME}-test || true
            docker rm ${APP_NAME}-test || true
        """
    }
}

        stage('Deploy Production Container') {
            steps {
                echo 'Deploying production container...'

                sh """
                    docker stop node-app-container || true
                    docker rm node-app-container || true

                    docker run -d \
                        --name node-app-container \
                        -p ${PRODUCTION_PORT}:3000 \
                        --restart unless-stopped \
                        ${IMAGE_NAME}:latest

                    sleep 5

                    echo "Production container status:"
                    docker ps --filter "name=node-app-container"

                    echo "Production container logs:"
                    docker logs --tail 50 node-app-container
                """
            }
        }
    }

    post {

        always {
            echo 'Cleaning up unused Docker resources...'

            sh '''
                docker container prune -f || true
            '''
        }

        success {
            echo "Pipeline completed successfully!"
            echo "Build #${BUILD_NUMBER} deployed on Port ${PRODUCTION_PORT}"
            echo "Application URL: http://<EC2-PUBLIC-IP>"
        }

        failure {
            echo "Pipeline failed on Build #${BUILD_NUMBER}. Check logs above."
        }
    }
}